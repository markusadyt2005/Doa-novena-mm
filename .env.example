# Add these in Vercel > Project > Settings > Environment Variables (Production).
# Never put the real values in GitHub or in the HTML.
APP_ORIGIN=https://doa-novena.vercel.app
# Vercel's Upstash integration usually supplies this pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative for a manually configured database. No need to copy KV values here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
